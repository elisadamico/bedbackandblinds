{# Site-wide footer. Edit the details in src/_data/site.json. #}
<footer class="site-footer">
  <div class="container">
    <nav class="footer-sitemap" aria-label="Site map">
      {% for item in site.nav %}
      <div>
        <a class="footer-head" href="{{ item.url }}">{{ item.label }}</a>
        {% if item.children %}<ul>{% for child in item.children %}{% if child.url != item.url %}<li><a href="{{ child.url }}">{{ child.label }}</a></li>{% endif %}{% endfor %}</ul>{% endif %}
      </div>
      {% endfor %}
    </nav>
    <div class="footer-main">
      <div class="footer-contact">
        <img src="/assets/img/brands/logo-2.png" alt="Bed Back & Blinds, family owned and operated" width="320" height="58" loading="lazy">
        <ul class="social">
          <li><a href="{{ site.facebook }}" aria-label="Bed Back & Blinds on Facebook"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M13.5 21v-8h2.7l.4-3.2h-3.1V7.8c0-.9.3-1.5 1.6-1.5h1.7V3.4c-.3 0-1.3-.1-2.5-.1-2.4 0-4.1 1.5-4.1 4.2v2.3H7.5V13h2.7v8h3.3z"/></svg></a></li>
          <li><a href="{{ site.instagram }}" aria-label="Bed Back & Blinds on Instagram"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M12 7.3A4.7 4.7 0 1 0 12 16.7 4.7 4.7 0 0 0 12 7.3zm0 7.7a3 3 0 1 1 0-6 3 3 0 0 1 0 6zm6-7.9a1.1 1.1 0 1 1-2.2 0 1.1 1.1 0 0 1 2.2 0zM21.5 8.1c-.1-1.5-.4-2.9-1.5-4s-2.5-1.4-4-1.5C14.4 2.5 9.6 2.5 8 2.6c-1.5.1-2.9.4-4 1.5S2.6 6.6 2.5 8.1c-.1 1.6-.1 6.4 0 8 .1 1.5.4 2.9 1.5 4s2.5 1.4 4 1.5c1.6.1 6.4.1 8 0 1.5-.1 2.9-.4 4-1.5s1.4-2.5 1.5-4c.1-1.6.1-6.4 0-8zM19.6 18a3 3 0 0 1-1.7 1.7c-1.2.5-4 .4-5.9.4s-4.7.1-5.9-.4A3 3 0 0 1 4.4 18c-.5-1.2-.4-4-.4-5.9s-.1-4.7.4-5.9A3 3 0 0 1 6.1 4.4c1.2-.5 4-.4 5.9-.4s4.7-.1 5.9.4A3 3 0 0 1 19.6 6c.5 1.2.4 4 .4 5.9s.1 4.8-.4 6.1z"/></svg></a></li>
        </ul>
        <p><strong>{{ site.name }}</strong><br>{{ site.address | join("<br>") | safe }}<br><a href="{{ site.map }}">Get directions</a></p>
        <p><a href="{{ site.phone_href }}">{{ site.phone }}</a><br><a href="mailto:{{ site.email }}">{{ site.email }}</a></p>
      </div>
      <table class="hours">
        <caption>Store hours</caption>
        {% for h in site.hours %}<tr><th scope="row">{{ h.day }}</th><td>{{ h.time }}</td></tr>{% endfor %}
      </table>
    </div>
    <p class="copyright">&copy; {% year %} {{ site.name }} · {{ site.tagline }} · Dubuque, Iowa</p>
  </div>
</footer>
