{# Site-wide header. Edit the menu and contact details in src/_data/site.json. #}
<div class="topbar">
  <div class="container">
    <a href="{{ site.phone_href }}">{{ site.phone }}</a>
    <span class="sep" aria-hidden="true">•</span>
    <a href="{{ site.map }}">{{ site.address | join(", ") }}</a>
  </div>
</div>
<header class="site-header">
  <div class="container header-inner">
    <a class="logo" href="/"><img src="/assets/img/brands/logo-2.png" alt="Bed Back & Blinds, family owned and operated" width="423" height="77"></a>
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav"><span class="bars" aria-hidden="true"></span>Menu</button>
    <nav id="site-nav" class="site-nav" aria-label="Main">
      <ul class="nav-list">
        {% for item in site.nav %}
        {% if item.children %}
        {% set open = item.children | containsUrl(page.url) %}
        <li class="has-sub">
          <button class="sub-toggle{% if open or page.url.startsWith(item.url) %} is-current{% endif %}" type="button" aria-expanded="false" aria-controls="sub-{{ loop.index }}">{{ item.label }}
            <svg class="caret" viewBox="0 0 10 6" width="10" height="6" aria-hidden="true"><path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
          <ul id="sub-{{ loop.index }}" class="sub-list">
            {% for child in item.children %}<li><a href="{{ child.url }}"{% if child.url == page.url %} aria-current="page"{% endif %}>{{ child.label }}</a></li>{% endfor %}
          </ul>
        </li>
        {% else %}
        <li><a href="{{ item.url }}"{% if item.url == page.url %} aria-current="page"{% endif %}>{{ item.label }}</a></li>
        {% endif %}
        {% endfor %}
        <li class="nav-cta"><a class="btn" href="/#contact">Contact us</a></li>
      </ul>
    </nav>
  </div>
</header>
<a class="consult-bar" href="{{ site.consultation_form }}">Click here to schedule your complimentary window treatment consultation</a>
