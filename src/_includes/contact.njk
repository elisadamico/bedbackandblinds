<section class="section" id="contact">
  <div class="container">
    <div class="section-head"><h2>Contact Us</h2><p>Get in touch with us today! Stop by the showroom, call, or send us an email.</p></div>
    <div class="contact-grid">
      <div class="contact-card">
        <ul class="contact-list">
          <li><span class="dot" aria-hidden="true"><svg viewBox="0 0 24 24" width="16" height="16"><path fill="currentColor" d="M12 2a7 7 0 0 0-7 7c0 5 7 13 7 13s7-8 7-13a7 7 0 0 0-7-7zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5z"/></svg></span><span><a href="{{ site.map }}">{{ site.address | join(", ") }}</a><br><small>{{ site.address_note }}</small></span></li>
          <li><span class="dot" aria-hidden="true"><svg viewBox="0 0 24 24" width="16" height="16"><path fill="currentColor" d="M6.6 10.8a15 15 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1z"/></svg></span><span><a href="{{ site.phone_href }}">{{ site.phone }}</a><br><small>Window treatment consultations: call {{ site.consult_contact }} at {{ site.consult_phone }}</small></span></li>
          <li><span class="dot" aria-hidden="true"><svg viewBox="0 0 24 24" width="16" height="16"><path fill="currentColor" d="M3 5h18v14H3zm9 7L5 7v10h14V7z"/></svg></span><span><a href="mailto:{{ site.email }}">{{ site.email }}</a></span></li>
        </ul>
        <div class="btn-row">
          <a class="btn" href="mailto:{{ site.email }}?subject=Question%20for%20Bed%20Back%20%26%20Blinds">Email us</a>
          <a class="btn btn-cyan" href="{{ site.consultation_form }}">Schedule a consultation</a>
          <a class="btn btn-outline" href="{{ site.map }}">Get directions</a>
        </div>
      </div>
            <form class="contact-card contact-form" action="{{ site.form_action }}" method="POST">
        <h3>Send us a message</h3>
        <input type="hidden" name="_subject" value="New message from the Bed Back &amp; Blinds website">
        <input type="hidden" name="_template" value="table">
        <input type="hidden" name="_next" value="{{ site.url }}/thanks/">
        <input type="text" name="_honey" class="honey" tabindex="-1" autocomplete="off" aria-hidden="true">
        <div class="form-row">
          <label>First name*<input type="text" name="First name" required autocomplete="given-name"></label>
          <label>Last name*<input type="text" name="Last name" required autocomplete="family-name"></label>
        </div>
        <div class="form-row">
          <label>Email*<input type="email" name="email" required autocomplete="email"></label>
          <label>Phone<input type="tel" name="Phone" autocomplete="tel"></label>
        </div>
        <label>I'm interested in
          <select name="Interested in">
            <option>Mattresses &amp; adjustable bases</option>
            <option>Window treatments / free consultation</option>
            <option>Furniture</option>
            <option>Something else</option>
          </select>
        </label>
        <label>Message*<textarea name="Message" rows="5" required data-message></textarea></label>
        <button class="btn" type="submit">Send message</button>
        <p class="form-note">Your message goes straight to {{ site.email }}. We'll get back to you soon.</p>
      </form>
    </div>
    <iframe class="map-embed" style="margin-top:2rem;min-height:300px" title="Map to Bed Back & Blinds" loading="lazy" referrerpolicy="no-referrer-when-downgrade" src="https://www.google.com/maps?q=Bed+Back+%26+Blinds,+806+Wacker+Dr+Suite+142,+Dubuque,+IA+52002&output=embed"></iframe>
  </div>
</section>
