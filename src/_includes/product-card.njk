<article class="product-card" data-brand="{{ p.brand }}" data-type="{{ p.type }}" data-price="{{ p.price }}">
  <a class="product-thumb" href="/mattresses/{{ p.slug }}/"><img src="{{ p.images[0] }}" alt="{{ p.brand }} {{ p.name }}" loading="lazy"></a>
  <div class="product-body">
    <p class="product-brand">{{ p.brand }}{% if p.feel %} · {{ p.feel }}{% endif %}{% if p.type != "mattress" %} · {{ "Adjustable base" if p.type == "base" else "Foundation" }}{% endif %}</p>
    <h3><a href="/mattresses/{{ p.slug }}/">{{ p.name }}</a></h3>
    <p class="product-price">{{ p.price | money }} <span>{{ p.price_label }}</span></p>
  </div>
</article>
