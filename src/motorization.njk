---
layout: base.njk
title: Motorized Blinds & Shades
description: Motorized blinds, shades, and drapery from Hunter Douglas, Alta, Graber, Carole Fabrics, and Draper, installed by Bed Back & Blinds in Dubuque, Iowa.
motorBrands:
  - { key: hunter-douglas, name: "Hunter Douglas", system: "PowerView® Automation", line: "PowerView Automation", page: /hunter-douglas/, logo: /assets/img/brands/logo-hunter-douglas.jpg }
  - { key: alta, name: "Alta", system: "BLISS and Somfy Automation", line: "Motorized Blinds and Shades", page: /alta-window-fashions/, logo: /assets/img/brands/alta.png }
  - { key: graber, name: "Graber", system: "App, Remote, and Wand Control", line: "Graber Motorization", page: /graber-blinds/, logo: /assets/img/brands/graber.jpg }
  - { key: carole, name: "Carole Fabrics", system: "Motorized Drapery and Roman Shades", line: "Motorization", page: /carole-fabrics/, logo: /assets/img/brands/carole.png }
  - { key: draper, name: "Draper", system: "IntelliFlex I/O (commercial)", line: "IntelliFlex I/O Controls", page: /draper-inc/, logo: /assets/img/brands/draper-raleigh-nc-window-blinds-shades-and-shutters.png }
---
<section class="section">
  <div class="container">
    <div class="section-head"><h1>Motorization</h1><p>Motorized shades open and close at the touch of a button, on a schedule, or by voice. No cords to tangle, and no reaching for hard-to-get-to windows. Every brand we carry offers motorized options.</p></div>
    <div class="brand-cards">
      {% for b in motorBrands %}<a class="brand-card" href="#{{ b.key }}"><img src="{{ b.logo }}" alt="{{ b.name }}" loading="lazy"><span>{{ b.system }}</span></a>
      {% endfor %}
    </div>
    <div class="btn-row center-row" style="margin-top:2rem"><a class="btn" href="{{ site.consultation_form }}">Book a free consultation</a><a class="btn btn-cyan" href="tel:+1{{ site.consult_phone | replace('-', '') }}">Call Donna at {{ site.consult_phone }}</a></div>
  </div>
</section>
{% for b in motorBrands %}{% set groups = windowlines[b.key] %}{% set sys = groups | findLine(b.line) %}{% set styles = groups | motorLines(b.line) %}
<section class="section{% if loop.index is odd %} section-soft{% endif %}" id="{{ b.key }}">
  <div class="container split top">
    <div>{% if sys.images.length %}<img class="rounded" src="{{ sys.images[0] }}" alt="{{ b.name }} {{ sys.name }}" loading="lazy">{% endif %}</div>
    <div class="prose">
      <h2>{{ b.name }}: {{ b.system }}</h2>
      <p>{{ sys.summary }}</p>
      {% if sys.features.length %}<ul class="perks">{% for f in sys.features %}<li>{{ f }}</li>{% endfor %}</ul>{% endif %}
      {% if styles.length %}<h3 class="motor-styles">Motorized {{ b.name }} styles</h3>
      <div class="chip-list left">{% for l in styles %}<a class="chip" href="{{ b.page }}#{{ l.name | slugify }}">{{ l.name }}</a>{% endfor %}</div>{% endif %}
      <div class="btn-row" style="margin-top:1.25rem"><a class="btn btn-outline" href="{{ b.page }}#{{ sys.name | slugify }}">More about {{ b.name }} motorization</a>{% if b.key == "hunter-douglas" %}<a class="btn btn-outline" href="{{ site.hd_design_guide }}#page=12">PowerView brochure (PDF)</a>{% endif %}</div>
    </div>
  </div>
</section>
{% endfor %}
{% include "contact.njk" %}
