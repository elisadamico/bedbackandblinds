---
layout: base.njk
title: Mattresses & Adjustable Bases
description: Shop Tempur-Pedic and Sealy mattresses and adjustable bases at Bed Back & Blinds in Dubuque, Iowa.
sizes:
  - { name: "Twin / Single", dims: "74.5\" L × 38\" W", range: "$199 – $3,699", img: "/assets/img/site/screenshot-2024-05-05-at-11-09-12-am.jpg" }
  - { name: "Twin / Single Extra Long", dims: "79.5\" L × 38\" W", range: "$249 – $3,699", img: "/assets/img/site/screenshot-2024-05-05-at-11-12-42-am.jpg" }
  - { name: "Double / Full", dims: "74.5\" L × 53\" W", range: "$299 – $3,249", img: "/assets/img/site/screenshot-2024-05-05-at-11-09-30-am.jpg" }
  - { name: "Queen", dims: "79.5\" L × 60\" W", range: "$399 – $4,199", img: "/assets/img/site/screenshot-2024-05-05-at-11-09-43-am.jpg" }
  - { name: "California King", dims: "83.5\" L × 72\" W", range: "$599 – $4,899", img: "/assets/img/site/screenshot-2024-05-05-at-11-10-09-am.jpg" }
  - { name: "King", dims: "79.5\" L × 76\" W", range: "$599 – $4,899", img: "/assets/img/site/screenshot-2024-05-05-at-11-09-56-am.jpg" }
---
<section class="hero" style="background-image:url('/assets/img/site/matr.jpg')">
  <div class="container"><h1>Mattresses &amp; Adjustable Bases</h1><p>Tempur-Pedic and Sealy mattresses, adjustable bases, and foundations. Come try them in our Dubuque showroom.</p></div>
</section>

{% set boxed = products | shipsFree %}
{% if boxed.length %}
<section class="section bib" id="bed-in-a-box">
  <div class="container bib-inner">
    <div class="bib-text">
      <p class="bib-kicker"><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M12 2 3 6.5v11L12 22l9-4.5v-11zm0 2.2 6.6 3.3L12 10.8 5.4 7.5zM5 9.1l6 3v7.6l-6-3zm8 10.6v-7.6l6-3v7.6z"/></svg> Bed in a Box</p>
      <h2>Ships Free to Your Door</h2>
      <p>{% if boxed.length == 1 %}This mattress comes{% else %}These mattresses come{% endif %} compressed in a box or bag and {% if boxed.length == 1 %}ships{% else %}ship{% endif %} straight from the manufacturer by UPS, so you don't need to be near Dubuque to order.</p>
      <ul class="perks">
        <li>Free UPS shipping anywhere in the lower 48 states</li>
        <li>{% if shop.checkout_url %}Order online here, or call us at <a href="{{ site.phone_href }}">{{ site.phone }}</a>{% else %}Call us at <a href="{{ site.phone_href }}">{{ site.phone }}</a> to order{% endif %}</li>
      </ul>
    </div>
    <div class="product-grid bib-grid">{% for p in boxed %}{% include "product-card.njk" %}{% endfor %}</div>
  </div>
</section>
{% endif %}

<section class="section">
  <div class="container">
    <div class="shop-bar">
      <div class="chips" role="group" aria-label="Filter products">
        <button class="chip" type="button" data-filter="all" aria-pressed="true">All</button>
        <button class="chip" type="button" data-filter="Tempur-Pedic®" aria-pressed="false">Tempur-Pedic</button>
        <button class="chip" type="button" data-filter="Sealy®" aria-pressed="false">Sealy</button>
        <button class="chip" type="button" data-filter="mattress" aria-pressed="false">Mattresses</button>
        <button class="chip" type="button" data-filter="base" aria-pressed="false">Adjustable bases</button>
      </div>
      <div><span class="count" data-count></span>
        <label> · Sort by <select data-sort><option value="featured">Featured</option><option value="low">Price: low to high</option><option value="high">Price: high to low</option></select></label>
      </div>
    </div>
    <p class="price-note">Prices shown are for Queen size. Call or stop by for other sizes and current sales.</p>
    {% for pr in promos %}{% if pr.details %}<p class="price-note" data-promo="{{ pr.start }}|{{ pr.end }}"><span class="promo-only">{{ pr.name }} on select models. <a href="{{ pr.details }}">See offer details</a></span></p>{% endif %}{% endfor %}
    <div class="product-grid" data-product-grid>
      {% for p in products | mattressesOnly %}{% include "product-card.njk" %}{% endfor %}
    </div>
  </div>
</section>

<section class="section">
  <div class="container split">
    <div class="center"><img src="/assets/img/brands/malouf.png" alt="Malouf" style="max-width:280px;margin:0 auto" loading="lazy"></div>
    <div><h2>Pillows, Sheets &amp; Protectors from Malouf</h2><p>Finish your new bed with Malouf pillows, sheets, and mattress protectors. Ask us in the showroom and we'll help you find the right pillow for the way you sleep.</p><a class="btn" href="/malouf/">See Malouf bedding</a></div>
  </div>
</section>

<section class="section section-soft">
  <div class="container">
    <div class="section-head"><h2>Mattress Sizing &amp; Pricing</h2><p>Price ranges across all the mattresses we carry, by size</p></div>
    <div class="sizes">
      {% for s in sizes %}<div class="size"><img src="{{ s.img }}" alt="{{ s.name }} mattress diagram, {{ s.dims }}" loading="lazy"><strong>{{ s.name }}</strong><br><small>{{ s.dims }}</small><div class="range">{{ s.range }}</div></div>{% endfor %}
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section-head"><h2>Browse Our Mattress Brands</h2></div>
    <div class="brand-cards">
      <a class="brand-card" href="/tempur-pedic/"><img src="/assets/img/brands/tempurpedic-01.png" alt="Tempur-Pedic" loading="lazy">Browse Tempur-Pedic</a>
      <a class="brand-card" href="/sealy/"><img src="/assets/img/brands/sealy.png" alt="Sealy" loading="lazy">Browse Sealy</a>
    </div>
  </div>
</section>
{% include "contact.njk" %}
